# 決算管理システム 環境変数サンプル
# このファイルをコピーして .env を作成する。
#   - 開発（platform/docker-compose.yml）: platform/.env に置く。空欄のままでも起動できる
#   - 本番（platform/docker-compose.prod.yml）: 配置先（DEPLOY_PATH）に .env として置く。
#     「本番で必須」の値を埋める（docs/runbooks/production-server-setup.md）
# web が読む値は app/web/src/lib/server/config-schema.ts で検査する。

# ── データベース（PostgreSQL） ─────────────────────────────────────
# ローカルで npm run dev するときの接続先。compose の web は compose 側の値を使う
DATABASE_URL=postgresql://app:app@localhost:5432/financial
# 本番で必須: db コンテナの初期ユーザーと、web からの接続先
#   DATABASE_URL=postgresql://<user>:<pass>@db:5432/financial
#POSTGRES_USER=
#POSTGRES_PASSWORD=
#POSTGRES_DB=financial

# ── 本番のイメージ（CD が上書きする） ─────────────────────────────
#WEB_IMAGE=ghcr.io/<owner>/<repo>/web:main

# ── Next.js ────────────────────────────────────────────────────────
NODE_ENV=development

# ── Redis（キャッシュ・レート制限） ────────────────────────────────
# compose では compose 側で redis://redis:6379 を渡す。つながらないときはキャッシュなしで動く
#REDIS_URL=redis://localhost:6379

# ── セッションと Cookie ────────────────────────────────────────────
# 本番で必須: 公開 URL（CSRF の Origin 検査に使う）
#APP_ORIGIN=https://example.com
# Cookie に Secure を付けるか（既定 true。http で動かす開発だけ false）
#COOKIE_SECURE=true
# アイドルタイムアウト（時間、既定 24）と絶対期限（日、既定 7）
#SESSION_IDLE_HOURS=24
#SESSION_ABSOLUTE_DAYS=7

# ── 期限切れセッションの掃除（session-cleanup → POST /api/admin/cleanup） ──
# 本番で必須: 32 文字以上のランダムな値（例: openssl rand -hex 32）。
# 開発では空欄なら compose の既定値を使う
#CLEANUP_SERVICE_KEY=

# ── 証憑のアップロード ─────────────────────────────────────────────
# 1 ファイルの上限（バイト、既定 10MB）
#UPLOAD_MAX_BYTES=10485760

# ── 有料プラン（Stripe、使うときだけ） ─────────────────────────────
# 秘密鍵と価格 ID の両方が無ければ、プランと支払いの画面の申し込みは「準備中」になる。
# Webhook の送り先は https://<公開 URL>/api/webhooks/stripe。受け取るイベントは
# checkout.session.completed・customer.subscription.created/updated/deleted・invoice.payment_failed
#STRIPE_SECRET_KEY=sk_live_...
#STRIPE_WEBHOOK_SECRET=whsec_...
#STRIPE_PRICE_ID=price_...

# ── 外部連携（使うときだけ） ───────────────────────────────────────
# freee（OAuth 2.0）
#FREEE_CLIENT_ID=
#FREEE_CLIENT_SECRET=
#FREEE_REDIRECT_URI=https://example.com/api/integrations/freee?action=callback
# マネーフォワード（OAuth 2.0）
#MF_CLIENT_ID=
#MF_CLIENT_SECRET=
#MF_REDIRECT_URI=https://example.com/api/integrations/moneyforward?action=callback
# オープンバンキング
#OPENBANKING_API_BASE=https://api.openbanking.or.jp/v1
#OPENBANKING_API_KEY=
# 連携画面の「接続済み」表示（NEXT_PUBLIC_ はビルド時に埋め込まれる）
#NEXT_PUBLIC_FREEE_CONFIGURED=false
#NEXT_PUBLIC_MF_CONFIGURED=false
