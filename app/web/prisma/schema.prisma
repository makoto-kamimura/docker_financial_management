// 決算管理システム データモデル
// 参照: docs/design.md「6. データモデル」

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// 勘定科目カテゴリ
enum AccountCategory {
  REVENUE // 売上・収入
  COGS // 売上原価・変動費
  EXPENSE // 販管費・固定費
  PROFIT // 利益・貯蓄
  ASSET // 資産（貸借対照表）
  LIABILITY // 負債（貸借対照表）
  OTHER
}

// 予測手法
enum ForecastMethod {
  MOVING_AVERAGE
  LINEAR_REGRESSION
  GROWTH_RATE
}

// 予測シナリオ
enum ForecastScenario {
  OPTIMISTIC
  BASE
  PESSIMISTIC
}

// 勘定科目マスタ
model Account {
  id            Int             @id @default(autoincrement())
  tenantId      Int
  code          String
  name          String // 既定表示名（家庭モードの科目名）
  soleName      String? // 個人事業主モードでの表示科目名（null は name にフォールバック）
  corporateName String? // 法人モードでの表示科目名（null は name にフォールバック）
  category      AccountCategory @default(OTHER)
  parentId      Int? // 親勘定科目 ID（null = トップレベル）
  parent        Account?        @relation("AccountTree", fields: [parentId], references: [id])
  children      Account[]       @relation("AccountTree")
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  records               FinancialRecord[]
  forecasts             Forecast[]
  budgets               Budget[]
  budgetHistories       BudgetHistory[]
  linkedAccounts        LinkedAccount[]
  journalDetails        JournalDetail[]
  apportionments        Apportionment[]
  journalTemplateLines  JournalTemplateLine[]
  accruedRevenues       AccruedRevenue[]
  accruedExpenses       AccruedExpense[]
  loans                 Loan[]
  personalAssets        PersonalAsset[]
  allocationRules       AllocationRule[]
  categorizedTxns       BankTransaction[]
  categorizedCardTxns   CardTransaction[]
  txnCategoryRules      TxnCategoryRule[]
  bankAccounts          BankAccount[]
  cardRecurringPayments CardRecurringPayment[]

  @@unique([tenantId, code])
  @@index([tenantId])
  @@map("accounts")
}

// 部門 / セグメントマスタ
model Department {
  id       Int          @id @default(autoincrement())
  tenantId Int
  name     String
  manager  String? // 担当者名
  parentId Int?
  parent   Department?  @relation("DepartmentTree", fields: [parentId], references: [id])
  children Department[] @relation("DepartmentTree")

  records FinancialRecord[]

  @@index([tenantId])
  @@map("departments")
}

// 会計期間マスタ
model Period {
  id         Int @id @default(autoincrement())
  tenantId   Int
  fiscalYear Int
  quarter    Int // 1-4
  month      Int // 1-12

  records         FinancialRecord[]
  forecasts       Forecast[]
  budgets         Budget[]
  budgetHistories BudgetHistory[]

  @@unique([tenantId, fiscalYear, month])
  @@index([tenantId])
  @@map("periods")
}

// 予算データ（予実対比に使用）
model Budget {
  id        Int      @id @default(autoincrement())
  tenantId  Int
  account   Account  @relation(fields: [accountId], references: [id])
  accountId Int
  period    Period   @relation(fields: [periodId], references: [id])
  periodId  Int
  amount    Decimal  @db.Decimal(18, 2)
  createdAt DateTime @default(now())

  histories BudgetHistory[]

  @@unique([tenantId, accountId, periodId])
  @@index([tenantId])
  @@map("budgets")
}

// 予算データの変更履歴（入力・更新・削除の日時とユーザーを記録）。
// 実績の FinancialRecordHistory と同じ役割だが、予算は削除されても履歴を残したいため
// budgetId を nullable にし、勘定科目・期間は履歴側に持たせて参照断を避ける。
model BudgetHistory {
  id        Int      @id @default(autoincrement())
  tenantId  Int
  budget    Budget?  @relation(fields: [budgetId], references: [id], onDelete: SetNull)
  budgetId  Int?
  account   Account  @relation(fields: [accountId], references: [id])
  accountId Int
  period    Period   @relation(fields: [periodId], references: [id])
  periodId  Int
  userId    Int? // 操作ユーザー（null = CSV インポート等のシステム操作）
  action    String // "create" | "update" | "delete"
  amount    Decimal  @db.Decimal(18, 2) // 操作時点の金額
  changedAt DateTime @default(now())

  @@index([tenantId, changedAt])
  @@index([budgetId])
  @@map("budget_histories")
}

// 予算配分ルール（FP 推奨の収入比率マスタ。ステップ 2 の配分提案に使用）
// 既定ルール（旧モバイル DEFAULT_ALLOCATION）をテナント作成時に自動投入する。
model AllocationRule {
  id         Int      @id @default(autoincrement())
  tenantId   Int
  key        String // ルール識別子（rent / food など）
  label      String // 表示名（家賃・住宅ローン など）
  group      String // 固定費 / 生活費 / その他
  minPercent Decimal  @db.Decimal(5, 2) // 推奨割合の下限（%）
  maxPercent Decimal? @db.Decimal(5, 2) // 推奨割合の上限（%）。null = 上限なし
  note       String? // 補足（「理想は25%以内」など）
  account    Account? @relation(fields: [accountId], references: [id])
  accountId  Int? // 対応する支払項目科目（null = 未紐付け）
  sortOrder  Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([tenantId, key])
  @@index([tenantId])
  @@map("allocation_rules")
}

// 実績データ
model FinancialRecord {
  id             Int           @id @default(autoincrement())
  tenantId       Int
  account        Account       @relation(fields: [accountId], references: [id])
  accountId      Int
  department     Department?   @relation(fields: [departmentId], references: [id])
  departmentId   Int?
  period         Period        @relation(fields: [periodId], references: [id])
  periodId       Int
  amount         Decimal       @db.Decimal(18, 2)
  // D-5a: 発生元の仕訳（syncJournalToFinancialRecords() 経由で作成された行のみ設定される。
  // 手動 /api/financials・CSV 取込・F-5 明細転記等の直接書き込みは null のまま）。
  // 仕訳削除時にこの逆参照で同期済み行を辿って一緒に削除し、孤立行の発生を防ぐ。
  journalEntry   JournalEntry? @relation(fields: [journalEntryId], references: [id])
  journalEntryId Int?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  history           FinancialRecordHistory[]
  postedFromTxn     BankTransaction?
  postedFromCardTxn CardTransaction?

  @@index([tenantId, accountId, periodId])
  @@index([journalEntryId])
  @@map("financial_records")
}

// 実績データ変更履歴（入力・更新・削除の日時とユーザーを記録）
model FinancialRecordHistory {
  id        Int             @id @default(autoincrement())
  record    FinancialRecord @relation(fields: [recordId], references: [id], onDelete: Cascade)
  recordId  Int
  userId    Int? // 操作ユーザー（null = CSV インポート等のシステム操作）
  action    String // "create" | "update" | "delete"
  amount    Decimal         @db.Decimal(18, 2) // 操作時点の金額
  changedAt DateTime        @default(now())

  @@index([recordId])
  @@map("financial_record_histories")
}

// 予測データ
model Forecast {
  id        Int              @id @default(autoincrement())
  tenantId  Int
  account   Account          @relation(fields: [accountId], references: [id])
  accountId Int
  period    Period           @relation(fields: [periodId], references: [id])
  periodId  Int
  method    ForecastMethod   @default(LINEAR_REGRESSION)
  scenario  ForecastScenario @default(BASE)
  amount    Decimal          @db.Decimal(18, 2)
  createdAt DateTime         @default(now())

  @@index([tenantId])
  @@map("forecasts")
}

// クレジットカード台帳（D-1: 銀行口座は BankAccount に一本化し、本モデルはカード専用）
model LinkedAccount {
  id          Int      @id @default(autoincrement())
  tenantId    Int
  name        String // カード名（表示名）
  // CREDIT_CARD（クレジットカード）/ DEBIT_CARD（デビットカード）/
  // PREPAID_CARD（プリペイドカード）/ E_MONEY（電子マネー・QR 決済）
  type        String
  institution String // カード会社名
  lastFour    String? // カード番号の下4桁
  accountId   Int? // 紐付く勘定科目（LIABILITY）
  account     Account? @relation(fields: [accountId], references: [id])
  note        String? // メモ
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  transactions            CardTransaction[]
  transfers               Transfer[]
  // このカード・電子マネーへのチャージとして扱われている他カードの明細（CardTransaction.transferToAccount の逆側）
  chargedFrom             CardTransaction[]      @relation("CardTransferTo")
  // このカード・電子マネーへのチャージとして扱われている銀行明細（BankTransaction.chargeToAccount の逆側）
  bankCharges             BankTransaction[]      @relation("BankCharge")
  cardTransferRules       CardTransferRule[]     @relation("CardTransferRuleTarget")
  cardTransferRulesOnCard CardTransferRule[]     @relation("CardTransferRuleSource")
  recurringPayments       CardRecurringPayment[]

  @@index([tenantId])
  @@map("linked_accounts")
}

// クレジットカード利用明細（取込・入力したトランザクション）。
// BankTransaction と同構造・同機能を維持する（銀行側の仕様はそのまま。カード側を新規追加するのみ）。
// amount は +利用（支出） / -返金。account(LinkedAccount) は LIABILITY 科目に紐づく。
model CardTransaction {
  id                  Int              @id @default(autoincrement())
  account             LinkedAccount    @relation(fields: [accountId], references: [id])
  accountId           Int
  date                DateTime // 利用日
  description         String // 摘要（利用先）
  amount              Decimal          @db.Decimal(18, 2) // +利用（支出） / -返金
  source              TxnSource        @default(MANUAL)
  externalId          String? // 重複取込防止用の外部ID
  categoryAccountId   Int? // 紐付けた費目科目（Account、通常 EXPENSE）
  categoryAccount     Account?         @relation(fields: [categoryAccountId], references: [id])
  postedRecordId      Int?             @unique // 転記済み FinancialRecord（unique で二重転記を DB 層でも防止）
  postedRecord        FinancialRecord? @relation(fields: [postedRecordId], references: [id])
  // 他のカード・電子マネーへのチャージ（資金移動）である場合のチャージ先。
  // 例: 三井住友カードの「[信] ＪＡＬ Ｐａｙ」は JAL Global Wallet へのチャージであり、
  // 実際の支出は JAL 側の利用明細で計上される。両方を科目に紐付けると二重計上になるため、
  // この値を持つ行は銀行の transferGroupId と同じく科目紐付け・実績転記の対象外にする。
  transferToAccountId Int?
  transferToAccount   LinkedAccount?   @relation("CardTransferTo", fields: [transferToAccountId], references: [id])
  // チャージ元の明細と、チャージ先に入った明細を対にする識別子（銀行の transferGroupId と同じ考え方）。
  // チャージ先の CSV に入金行が出てくる場合、両方を持ったままだと「どのチャージがどの入金か」が
  // 分からず、入金行を科目に紐付けて収入として二重計上してしまう。対にした行はどちら側も
  // 科目紐付け・実績転記の対象外にする。bank_transactions.chargeGroupId と同じ ID 空間
  // （銀行 → プリペイド・デビットのチャージは銀行明細とカード明細の組になる）。
  chargeGroupId       String?
  createdAt           DateTime         @default(now())

  @@unique([accountId, externalId])
  @@index([accountId, date])
  @@index([categoryAccountId])
  @@index([transferToAccountId])
  @@index([chargeGroupId])
  @@map("card_transactions")
}

// カード明細の摘要キーワードから「チャージ（資金移動）」を自動判定するルール。
// TxnCategoryRule が科目を自動で埋めるのと同じ位置付けで、こちらは transferToAccountId を埋める。
// 明細一覧の一括操作（摘要一致でまとめてチャージにする）で作られ、以後の CSV 取込にも適用される。
model CardTransferRule {
  id                  Int           @id @default(autoincrement())
  tenantId            Int
  // 対象のカード（このカードの明細にだけ適用する。同じ摘要が別カードで別の意味を持つため）
  accountId           Int
  account             LinkedAccount @relation("CardTransferRuleSource", fields: [accountId], references: [id])
  keyword             String // 摘要の部分一致キーワード（大文字小文字無視で評価）
  // チャージ先のカード・電子マネー
  transferToAccountId Int
  transferToAccount   LinkedAccount @relation("CardTransferRuleTarget", fields: [transferToAccountId], references: [id])
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt

  @@unique([accountId, keyword])
  @@index([tenantId])
  @@map("card_transfer_rules")
}

// カードで毎月固定決済される支払い（サブスク・通信費など）。
//
// Transfer（資金移動ルール）と役割は似ているが、あちらは「銀行口座から現金が出る日」を表す。
// カード払いのサブスクは利用時点で現金が動かず、実際の出金はカード全体の引き落とし 1 本に
// まとまるため、Transfer として登録すると同じ支出が資金繰りに二重で乗る。そのため
// 銀行の資金繰り・残高予測には influence させない独立したモデルとして持つ。
//
// 用途は「このカードで毎月いくら固定で決済されるか」の把握（カード管理のサマリ・明細一覧）。
model CardRecurringPayment {
  id                Int           @id @default(autoincrement())
  tenantId          Int
  // 決済に使うカード・電子マネー
  account           LinkedAccount @relation(fields: [accountId], references: [id])
  accountId         Int
  label             String // 摘要（例: Netflix、携帯料金）
  amount            Decimal       @db.Decimal(18, 2)
  day               Int // 決済日 (1-31)
  categoryAccountId Int? // 費目科目（Account、通常 EXPENSE）
  categoryAccount   Account?      @relation(fields: [categoryAccountId], references: [id])
  note              String?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  // 同じカードに同じ摘要を重複登録させない（明細から登録するため取り違えやすい）
  @@unique([accountId, label])
  @@index([tenantId])
  @@index([categoryAccountId])
  @@map("card_recurring_payments")
}

// ユーザー（認証）
model User {
  id               Int       @id @default(autoincrement())
  tenantId         Int // 1テナントに複数ユーザーを所属させられる（N:1）
  tenant           Tenant    @relation(fields: [tenantId], references: [id])
  email            String    @unique
  name             String
  passwordHash     String
  role             String    @default("viewer") // admin / editor / accountant / viewer
  mfaEnabled       Boolean   @default(false)
  totpSecret       String? // Base32 エンコードされた TOTP シークレット
  totpLastUsedStep BigInt? // S-7: 直近で検証成功した TOTP ステップ番号（この値以下のコードは再利用として拒否する）
  mfaRecoveryCodes String? // JSON 配列: ハッシュ化されたリカバリーコード
  loginAttempts    Int       @default(0) // 連続失敗回数
  lockedUntil      DateTime? // アカウントロック解除時刻
  createdAt        DateTime  @default(now())

  sessions         Session[]
  journalApprovals JournalApproval[]
  mfaChallenges    MfaChallenge[]
  learningProgress LearningProgress[]

  @@index([tenantId])
  @@map("users")
}

// F-9: 学習ガイドの既読管理（userId 所有）。tenantId 列は持つが自動テナントスコープ拡張の
// 対象外（tenant-db.ts の TENANT_SCOPE_EXCLUDED_MODELS）とする。既読は個人の学習履歴で
// あり `userId: user.id` で厳格に絞り込むべきものであり、tenantId による自動注入は
// 「同テナント内の他ユーザーの既読が見える」誤りを構造的に防げないため。
model LearningProgress {
  id       Int      @id @default(autoincrement())
  tenantId Int
  tenant   Tenant   @relation(fields: [tenantId], references: [id])
  userId   Int
  user     User     @relation(fields: [userId], references: [id])
  topicKey String
  readAt   DateTime @default(now())

  @@unique([userId, topicKey])
  @@index([tenantId])
  @@map("learning_progress")
}

// セッション。id は SHA-256(token) を保存する（新形式 `fm2:` トークンのみ。
// 旧形式の平文トークンで発行されたセッションは移行期間中そのまま自然失効する）。
model Session {
  id         String   @id
  user       User     @relation(fields: [userId], references: [id])
  userId     Int
  expiresAt  DateTime // 絶対期限（発行から 7 日）
  lastSeenAt DateTime @default(now()) // アイドルタイムアウト判定（24h）
  ip         String? // 監査用
  userAgent  String? // 監査用
  createdAt  DateTime @default(now())

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

// MFA 2段階ログインの一時チャレンジ（パスワード認証後・TOTP/リカバリーコード検証前）。
// token は生トークンの SHA-256 ハッシュを保存する（DB 漏洩時も再利用不可）。
model MfaChallenge {
  token     String   @id
  user      User     @relation(fields: [userId], references: [id])
  userId    Int
  attempts  Int      @default(0)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
  @@map("mfa_challenges")
}

// 監査ログ
model AuditLog {
  id        Int      @id @default(autoincrement())
  tenantId  Int? // S-12: テナント横断調査用（ログイン失敗等 user 不明時は null）
  userId    Int?
  action    String
  target    String
  ip        String? // S-12
  userAgent String? // S-12（255 文字で切り詰め）
  before    String? // 変更前の値（JSON。redactSecrets() でハッシュ類はマスク済み）
  after     String? // 変更後の値（JSON。redactSecrets() でハッシュ類はマスク済み）
  changedAt DateTime @default(now())

  @@index([tenantId, changedAt])
  @@index([userId, changedAt])
  @@map("audit_logs")
}

// 銀行口座の役割
enum BankAccountRole {
  SALARY // 給与口座
  WITHDRAWAL // 引き落とし用口座
  SAVINGS // 貯蓄
  OTHER
}

// 資金移動の種別
enum TransferKind {
  MANUAL // 手動振込
  AUTO // 自動振替 / 自動引き落とし
}

// 資金移動のチャネル（口座引き落とし・カード引き落とし・入金・支出など）
enum TransferChannel {
  BANK_TRANSFER // 口座間振込
  AUTO_DEBIT // 銀行引き落とし（登録済み銀行口座を紐付け可能）
  CARD_PAYMENT // カード引き落とし（登録済みカード・電子マネーを紐付け可能）
  INCOME // 入金（給与等・外部から）
  EXPENSE // 支出（外部へ）
}

// 銀行入出金明細の取得元
enum TxnSource {
  MANUAL // 手入力
  CSV // CSV 取込
  SYNC // 自動同期（アグリゲーション）
}

// ── 個人事業主・確定申告支援 ───────────────────────────────────────────

// F001 事業者情報
model BusinessProfile {
  id            Int       @id @default(autoincrement())
  tenantId      Int       @unique
  tradeName     String? // 屋号
  ownerName     String    @default("") // 氏名
  openedOn      DateTime? // 開業日
  blueReturn    Boolean   @default(false) // 青色申告
  invoiceNumber String? // インボイス登録番号（T + 13桁）
  // D-6: 課税方式の既定値（フォールバック用）。対象年度の TaxSetting 行が存在する場合は
  // そちらが正であり、このカラムは新年度作成時の初期値・年度別設定が未登録の場合の
  // フォールバックとしてのみ参照される（例: api/closing/etax）。
  taxationType  String    @default("exempt") // exempt / general / simplified
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@map("business_profiles")
}

// F012 消費税設定（年度別）
// D-6: 課税方式は本モデルが正。tenantId + taxYear の行が存在すればこちらの
// taxationType を採用し、存在しない年度のみ BusinessProfile.taxationType にフォールバックする。
model TaxSetting {
  id             Int      @id @default(autoincrement())
  tenantId       Int
  taxYear        Int // 適用年度
  taxationType   String // exempt / general / simplified（年度別・正）
  simplifiedRate Decimal? @db.Decimal(5, 2) // 簡易課税みなし仕入率（%）
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([tenantId, taxYear])
  @@index([tenantId])
  @@map("tax_settings")
}

// F002 仕訳帳ヘッダ
model JournalEntry {
  id              Int      @id @default(autoincrement())
  tenantId        Int
  transactionDate DateTime // 取引日
  description     String // 摘要
  paymentMethod   String   @default("cash") // cash / bank / card / transfer
  taxCategory     String   @default("taxable") // taxable / exempt / non_taxable
  approvalStatus  String   @default("approved") // draft / pending / approved / rejected
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  details          JournalDetail[]
  receipts         Receipt[]
  approvals        JournalApproval[]
  financialRecords FinancialRecord[] // D-5a: 同期済み実績行の逆参照（削除時のクリーンアップに使用）

  @@index([tenantId, transactionDate])
  @@index([tenantId, approvalStatus])
  @@map("journal_entries")
}

// 電子帳簿保存法: 仕訳承認ワークフロー
model JournalApproval {
  id             Int          @id @default(autoincrement())
  journalEntry   JournalEntry @relation(fields: [journalEntryId], references: [id], onDelete: Cascade)
  journalEntryId Int
  action         String // submitted / approved / rejected
  actorId        Int
  actor          User         @relation(fields: [actorId], references: [id])
  comment        String?
  createdAt      DateTime     @default(now())

  @@index([journalEntryId])
  @@map("journal_approvals")
}

// F002 仕訳明細（複式簿記：借方/貸方）
model JournalDetail {
  id                Int          @id @default(autoincrement())
  journalEntry      JournalEntry @relation(fields: [journalEntryId], references: [id], onDelete: Cascade)
  journalEntryId    Int
  side              String // debit（借方）/ credit（貸方）
  account           Account      @relation(fields: [accountId], references: [id])
  accountId         Int
  amount            Decimal      @db.Decimal(18, 2)
  taxRate           Decimal?     @db.Decimal(5, 4) // 消費税率（0.10 / 0.08 / null=非課税）
  taxCreditEligible Boolean      @default(true) // 仕入税額控除対象か
  note              String? // 明細摘要

  @@index([journalEntryId])
  @@map("journal_details")
}

// F005 証憑ファイル
model Receipt {
  id             Int          @id @default(autoincrement())
  journalEntry   JournalEntry @relation(fields: [journalEntryId], references: [id], onDelete: Cascade)
  journalEntryId Int
  fileName       String // アップロード時の元ファイル名（表示用）
  fileUrl        String // 配信 URL（/api/uploads/<savedName>）
  savedName      String? // uploads/ 配下の実ファイル名（配信時の所有確認・Content-Type 決定に使用）
  mimeType       String? // アップロード時に検証済みの MIME タイプ
  fileType       String // pdf / image / other
  fileSize       Int
  uploadedAt     DateTime     @default(now())

  @@unique([savedName])
  @@index([journalEntryId])
  @@map("receipts")
}

// F006 棚卸帳ヘッダ
model Inventory {
  id              Int      @id @default(autoincrement())
  tenantId        Int
  name            String // 棚卸名（例: 2026年6月末棚卸）
  inventoryDate   DateTime // 棚卸日
  status          String   @default("open") // open / closed
  totalAmount     Decimal  @default(0) @db.Decimal(18, 2)
  valuationMethod String   @default("last_purchase") // last_purchase / average / moving_average
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  items InventoryItem[]

  @@index([tenantId, inventoryDate])
  @@map("inventories")
}

// F006 棚卸明細
model InventoryItem {
  id          Int       @id @default(autoincrement())
  inventory   Inventory @relation(fields: [inventoryId], references: [id], onDelete: Cascade)
  inventoryId Int
  itemName    String
  itemType    String    @default("product") // product / material / wip / goods
  quantity    Decimal   @db.Decimal(10, 3)
  unit        String    @default("個")
  unitPrice   Decimal   @db.Decimal(18, 2)
  totalAmount Decimal   @db.Decimal(18, 2) // quantity × unitPrice
  createdAt   DateTime  @default(now())

  @@index([inventoryId])
  @@map("inventory_items")
}

// F007 固定資産台帳
model FixedAsset {
  id              Int       @id @default(autoincrement())
  tenantId        Int
  name            String // 資産名
  category        String    @default("tangible") // tangible / intangible
  acquiredOn      DateTime // 取得日
  acquisitionCost Decimal   @db.Decimal(18, 2) // 取得金額
  usefulLife      Int // 耐用年数（年）
  method          String    @default("straight") // straight（定額）/ declining（定率）
  residualRate    Decimal   @default(0.1) @db.Decimal(5, 4) // 残存率（旧定率法）
  bookValue       Decimal   @db.Decimal(18, 2) // 帳簿価額
  disposedOn      DateTime? // 除却・売却日
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  depreciations Depreciation[]

  @@index([tenantId])
  @@map("fixed_assets")
}

// F008 減価償却明細
model Depreciation {
  id           Int        @id @default(autoincrement())
  fixedAsset   FixedAsset @relation(fields: [fixedAssetId], references: [id], onDelete: Cascade)
  fixedAssetId Int
  fiscalYear   Int
  amount       Decimal    @db.Decimal(18, 2) // 年間償却費
  createdAt    DateTime   @default(now())

  @@unique([fixedAssetId, fiscalYear])
  @@index([fixedAssetId])
  @@map("depreciations")
}

// 実物資産の分類（土地・建物・車・金など）
enum PersonalAssetCategory {
  LAND // 土地
  BUILDING // 建物
  VEHICLE // 車
  GOLD // 金・貴金属
  CASH // 現金（タンス預金）
  DEPOSIT // 預金（銀行口座と別で管理する定期預金等）
  SECURITIES // 投資（株式・投資信託等）
  OTHER
}

// 実物資産台帳（家計の資産管理: 土地・建物・車・金など）
// D-4: 紐付け負債（旧 debtStartOn/debtPayoffDue/debtInitialAmount）は Loan に一本化し、
// loanId で参照する。API は旧フィールド名の入出力を維持し、内部で Loan へ読み替える。
model PersonalAsset {
  id              Int                   @id @default(autoincrement())
  tenantId        Int
  name            String // 資産名（例: 自宅土地）
  category        PersonalAssetCategory @default(OTHER)
  acquiredOn      DateTime? // 取得日
  acquisitionCost Decimal?              @db.Decimal(18, 2) // 取得価格
  currentValue    Decimal               @db.Decimal(18, 2) // 現在評価額
  // 純資産（総資産サマリ）に評価額を計上するか。false = 負債のみ反映。
  // ローンに含まれる諸費用（登記費用・手数料等）のように、借入はあるが資産価値を持たない
  // 項目を除外するためのフラグ。以前はカテゴリ（LAND/BUILDING 以外を除外）で代用していたが、
  // 車・金など価値のある資産まで除外されてしまうため明示フラグへ移行した。
  countAsAsset    Boolean               @default(true)
  note            String?
  linkedAccountId Int? // 紐付く負債科目（例: 住宅ローン）
  linkedAccount   Account?              @relation(fields: [linkedAccountId], references: [id])
  loanId          Int?                  @unique // 紐付け負債の実体（Loan）。null = 負債なし
  loan            Loan?                 @relation(fields: [loanId], references: [id])
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt

  @@index([tenantId])
  @@index([linkedAccountId])
  @@map("personal_assets")
}

// F009 家事按分設定
model Apportionment {
  id           Int      @id @default(autoincrement())
  tenantId     Int
  account      Account  @relation(fields: [accountId], references: [id])
  accountId    Int
  businessRate Decimal  @db.Decimal(5, 2) // 事業利用率（%）
  description  String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([tenantId, accountId])
  @@index([tenantId])
  @@map("apportionments")
}

// F010 売掛金管理
// D-3: invoiceId は「請求書発行から自動生成された売掛金」を示す（POST /api/receivables 経由の
// 手動計上は null のまま）。リンク済みの場合、金額・得意先名は Invoice を正とする。
model Receivable {
  id            Int       @id @default(autoincrement())
  tenantId      Int
  customerName  String // 得意先名
  description   String // 件名・摘要
  amount        Decimal   @db.Decimal(18, 2) // 請求金額（税込）
  taxAmount     Decimal   @default(0) @db.Decimal(18, 2)
  issueDate     DateTime // 請求日
  dueDate       DateTime // 支払期限
  status        String    @default("open") // open / paid / overdue
  paidOn        DateTime? // 入金日
  paidAmount    Decimal?  @db.Decimal(18, 2) // 入金金額
  invoiceNumber String? // 請求書番号
  note          String?
  invoiceId     Int?      @unique // 発行元インボイス（自動生成の場合のみ）
  invoice       Invoice?  @relation(fields: [invoiceId], references: [id])
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([tenantId, dueDate])
  @@index([tenantId, status])
  @@map("receivables")
}

// F011 買掛金管理
model Payable {
  id           Int       @id @default(autoincrement())
  tenantId     Int
  supplierName String // 仕入先名
  description  String // 件名・摘要
  amount       Decimal   @db.Decimal(18, 2) // 請求金額（税込）
  taxAmount    Decimal   @default(0) @db.Decimal(18, 2)
  issueDate    DateTime // 請求書受取日
  dueDate      DateTime // 支払期限
  status       String    @default("open") // open / paid / overdue
  paidOn       DateTime? // 支払日
  paidAmount   Decimal?  @db.Decimal(18, 2) // 支払金額
  note         String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([tenantId, dueDate])
  @@index([tenantId, status])
  @@map("payables")
}

// ============================================================
// 法人・統合会計 — Phase 1: マルチテナント基盤
// ============================================================

// テナント（法人 / 個人事業主）
model Tenant {
  id              Int       @id @default(autoincrement())
  type            String    @default("SOLE_PROPRIETOR") // SOLE_PROPRIETOR / CORPORATION
  name            String // 屋号または法人名
  corporateNumber String? // 法人番号 13 桁
  capitalAmount   Decimal?  @db.Decimal(18, 2) // 資本金
  establishedOn   DateTime?
  closingMonth    Int       @default(12) // 決算月（1-12）
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  users            User[]
  fiscalYears      FiscalYear[]
  officers         Officer[]
  meetings         ShareholderMeeting[]
  dividends        Dividend[]
  announcements    Announcement[]
  learningProgress LearningProgress[]

  @@map("tenants")
}

// 会計年度（テナント別）。D-2 で FiscalYearClose を統合し、年度の存在と締め状態を単一行で管理する
model FiscalYear {
  id        Int       @id @default(autoincrement())
  tenant    Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  tenantId  Int
  year      Int
  startDate DateTime
  endDate   DateTime
  status    String    @default("open") // open / closed
  netIncome Decimal?  @db.Decimal(18, 2) // 決算確定時の当期純利益（closing/finalize が設定）
  closedAt  DateTime? // 決算確定日時
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@unique([tenantId, year])
  @@map("fiscal_years")
}

// ============================================================
// 法人・統合会計 — Phase 2: 会計帳簿機能強化
// ============================================================

// 仕訳テンプレート
model JournalTemplate {
  id          Int      @id @default(autoincrement())
  tenantId    Int
  name        String
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  lines JournalTemplateLine[]

  @@index([tenantId])
  @@map("journal_templates")
}

model JournalTemplateLine {
  id         Int             @id @default(autoincrement())
  template   JournalTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  templateId Int
  side       String // debit / credit
  account    Account         @relation(fields: [accountId], references: [id])
  accountId  Int
  amount     Decimal?        @db.Decimal(18, 2) // null = 入力時に指定
  note       String?
  sortOrder  Int             @default(0)

  @@map("journal_template_lines")
}

// ============================================================
// 法人・統合会計 — Phase 3: 在庫・銀行・借入金管理
// ============================================================

// 銀行口座（D-1 で LinkedAccount(BANK) を統合した唯一の銀行口座マスタ）
model BankAccount {
  id                Int             @id @default(autoincrement())
  tenantId          Int
  name              String // 表示名（例: 給与口座）
  bankName          String // 銀行名
  branchName        String? // 支店名
  accountType       String          @default("普通") // 普通 / 当座
  role              BankAccountRole @default(OTHER)
  lastFour          String? // 口座番号の下4桁
  accountId         Int? // 紐付く勘定科目（ASSET）。資産サマリの二重計上除外に使用
  account           Account?        @relation(fields: [accountId], references: [id])
  note              String? // メモ
  // 明細の合計と実際の残高との差額（円）。取込開始前から口座にあった残高（期首残高）や
  // 取り込めなかった明細を吸収する。残高＝SUM(bank_transactions.amount) + balanceAdjustment。
  balanceAdjustment Decimal         @default(0) @db.Decimal(18, 2)
  createdAt         DateTime        @default(now())

  outgoing     Transfer[]        @relation("from")
  incoming     Transfer[]        @relation("to")
  transactions BankTransaction[]

  @@index([tenantId])
  @@index([accountId])
  @@map("bank_accounts")
}

// 資金移動ルール（振込 / 銀行引き落とし / カード引き落とし / 入金 / 支出）
// fromAccountId / toAccountId は null 可（null = 外部＝給与・カード会社・各種支出先）
model Transfer {
  id              Int             @id @default(autoincrement())
  tenantId        Int
  fromAccount     BankAccount?    @relation("from", fields: [fromAccountId], references: [id])
  fromAccountId   Int?
  toAccount       BankAccount?    @relation("to", fields: [toAccountId], references: [id])
  toAccountId     Int?
  // カード引き落とし（CARD_PAYMENT）で、引き落とし対象の登録済みカード・電子マネーを紐付ける。
  // 銀行引き落とし（AUTO_DEBIT）で相手が自口座の場合は from/toAccountId 側で表現する。
  linkedAccount   LinkedAccount?  @relation(fields: [linkedAccountId], references: [id])
  linkedAccountId Int?
  amount          Decimal         @db.Decimal(18, 2)
  kind            TransferKind    @default(AUTO)
  channel         TransferChannel @default(BANK_TRANSFER)
  label           String? // 外部側の名称（例: 給与、◯◯カード、家賃）
  day             Int // 振込日 / 引き落とし日 (1-31)
  note            String?
  createdAt       DateTime        @default(now())

  @@index([tenantId])
  @@index([fromAccountId])
  @@index([toAccountId])
  @@index([linkedAccountId])
  @@map("transfers")
}

// 銀行入出金明細（取込・同期したトランザクション）
model BankTransaction {
  id                Int              @id @default(autoincrement())
  account           BankAccount      @relation(fields: [accountId], references: [id])
  accountId         Int
  date              DateTime // 取引日
  description       String // 摘要
  amount            Decimal          @db.Decimal(18, 2) // +入金 / -出金
  balance           Decimal?         @db.Decimal(18, 2) // 取引後残高（取得できた場合）
  source            TxnSource        @default(MANUAL)
  externalId        String? // 重複取込防止用の外部ID
  categoryAccountId Int? // 紐付けた収入・支払項目科目（Account）
  categoryAccount   Account?         @relation(fields: [categoryAccountId], references: [id])
  postedRecordId    Int?             @unique // 転記済み FinancialRecord（unique で二重転記を DB 層でも防止）
  postedRecord      FinancialRecord? @relation(fields: [postedRecordId], references: [id])
  // 口座間振替で対になる 2 行（出金元の −amount と入金先の +amount）を結ぶ ID。
  // 自己口座間の移動は収入でも支出でもないため、この値を持つ行は科目紐付け・実績転記の対象外にする
  // （集計は categoryAccountId を起点にしているので、未紐付けのままなら二重計上されない）。
  transferGroupId   String?
  // デビット・プリペイド・電子マネーへのチャージ（銀行 → カード台帳の資金移動）の場合のチャージ先。
  // 口座間振替（transferGroupId）と同じく自己資金の移動なので科目紐付け・実績転記の対象外にする
  // （実際の支出はチャージ先の利用明細で計上される）。card_transactions.transferToAccountId の銀行版。
  chargeToAccountId Int?
  chargeToAccount   LinkedAccount?   @relation("BankCharge", fields: [chargeToAccountId], references: [id])
  // チャージ先の明細（CardTransaction）と対にする識別子。card_transactions.chargeGroupId と同じ ID 空間
  chargeGroupId     String?
  createdAt         DateTime         @default(now())

  @@unique([accountId, externalId])
  @@index([accountId, date])
  @@index([categoryAccountId])
  @@index([transferGroupId])
  @@index([chargeToAccountId])
  @@index([chargeGroupId])
  @@map("bank_transactions")
}

// 明細の摘要キーワードから科目を自動分類するためのルール（取込時に categoryAccountId を埋めるだけで転記はしない）
model TxnCategoryRule {
  id                Int      @id @default(autoincrement())
  tenantId          Int
  keyword           String // 摘要の部分一致キーワード（大文字小文字無視で評価）
  categoryAccountId Int
  categoryAccount   Account  @relation(fields: [categoryAccountId], references: [id])
  priority          Int      @default(0) // 手動学習（learn=true）は 100。優先度降順→キーワード長い順で評価
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@unique([tenantId, keyword])
  @@index([tenantId])
  @@map("txn_category_rules")
}

// 借入金
model Loan {
  id                     Int      @id @default(autoincrement())
  tenantId               Int
  lenderName             String
  amount                 Decimal  @db.Decimal(18, 2)
  interestRate           Decimal  @db.Decimal(5, 4)
  borrowedOn             DateTime
  repaymentDate          DateTime // 完済予定/支払い完了年月
  remainingAmount        Decimal  @db.Decimal(18, 2)
  status                 String   @default("active") // active / repaid
  note                   String?
  loanType               String   @default("business") // business（事業性）/ housing（住宅ローン）
  linkedAccountId        Int? // 住宅ローン: 返済額を自動反映する予算科目（例: 家賃）
  linkedAccount          Account? @relation(fields: [linkedAccountId], references: [id])
  monthlyPayment         Decimal? @db.Decimal(18, 2) // 住宅ローン: 月々の返済額（予算に自動加算）
  // 残価設定ローン（カーローン等）で最終回に一括して支払う据置額。null / 0 = 通常ローン。
  // 毎月の返済はこの額を除いた分だけを償却するため月額が低くなり、最終回に残価が残る。
  residualValue          Decimal? @db.Decimal(18, 2)
  // true = monthlyPayment は金融機関の通知額を人が入力した「実額」。
  // 変動金利には 5 年ルール（金利が変わっても 5 年間は返済額を据え置き、内訳だけが変わる）が
  // あり、金利から計算した額と実額は一致しない。実額が入っている間は自動計算で上書きしない。
  monthlyPaymentIsManual Boolean  @default(false)
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  repayments    LoanRepayment[]
  rateChanges   LoanInterestRateChange[]
  personalAsset PersonalAsset? // D-4: 実物資産の紐付け負債として作成された場合の逆参照

  @@index([tenantId])
  @@index([linkedAccountId])
  @@map("loans")
}

// 変動金利の履歴。loans.interestRate は「現在の金利」を保持し、
// 変更の都度この表に1行積む（過去分は消さず、変動前後のスケジュール比較に使う）。
model LoanInterestRateChange {
  id                       Int      @id @default(autoincrement())
  loan                     Loan     @relation(fields: [loanId], references: [id], onDelete: Cascade)
  loanId                   Int
  effectiveOn              DateTime // 金利変更日（この月以降の返済に適用）
  interestRate             Decimal  @db.Decimal(5, 4) // 変更後の年利（%）
  previousRate             Decimal  @db.Decimal(5, 4) // 変更前の年利（%）。履歴表示用
  // 改定後の実際の月々返済額（金融機関の通知額）。null = 未入力（通知待ち／未確認）。
  // 入力されると loans.monthlyPayment へ反映され、以降の償還計算がこの額で走る。
  monthlyPayment           Decimal? @db.Decimal(18, 2)
  // 改定直前の月々返済額（loans.monthlyPayment のスナップショット）。旧金利時の月額を残す
  previousMonthlyPayment   Decimal? @db.Decimal(18, 2)
  // 「残高 × 残回数」で機械的に算出した参考月額。実額との差を UI で示すために保持する
  calculatedMonthlyPayment Decimal? @db.Decimal(18, 2)
  note                     String?
  createdAt                DateTime @default(now())

  @@unique([loanId, effectiveOn])
  @@index([loanId])
  @@map("loan_interest_rate_changes")
}

model LoanRepayment {
  id          Int      @id @default(autoincrement())
  loan        Loan     @relation(fields: [loanId], references: [id], onDelete: Cascade)
  loanId      Int
  repaidOn    DateTime
  principal   Decimal  @db.Decimal(18, 2)
  interest    Decimal  @db.Decimal(18, 2)
  totalAmount Decimal  @db.Decimal(18, 2)
  createdAt   DateTime @default(now())

  @@index([loanId])
  @@map("loan_repayments")
}

// ============================================================
// 法人・統合会計 — Phase 4: 消費税・インボイス強化
// ============================================================

// インボイス（適格請求書）
model Invoice {
  id              Int      @id @default(autoincrement())
  tenantId        Int
  invoiceNumber   String
  customerName    String
  customerAddress String?
  issueDate       DateTime
  dueDate         DateTime
  status          String   @default("draft") // draft / issued / paid
  subtotal        Decimal  @db.Decimal(18, 2)
  taxAmount       Decimal  @db.Decimal(18, 2)
  total           Decimal  @db.Decimal(18, 2)
  note            String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  lines      InvoiceLine[]
  receivable Receivable? // D-3: 発行（issued）時に自動生成される売掛金

  @@unique([tenantId, invoiceNumber])
  @@index([tenantId])
  @@map("invoices")
}

model InvoiceLine {
  id          Int     @id @default(autoincrement())
  invoice     Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  invoiceId   Int
  description String
  quantity    Decimal @db.Decimal(10, 3)
  unitPrice   Decimal @db.Decimal(18, 2)
  taxRate     Decimal @default(0.10) @db.Decimal(5, 4)
  amount      Decimal @db.Decimal(18, 2)

  @@map("invoice_lines")
}

// ============================================================
// 法人・統合会計 — Phase 5: 決算整理
// ============================================================

// 未収収益・未払費用（決算整理仕訳）
model AccruedRevenue {
  id          Int      @id @default(autoincrement())
  tenantId    Int
  description String
  amount      Decimal  @db.Decimal(18, 2)
  accrualDate DateTime
  account     Account  @relation(fields: [accountId], references: [id])
  accountId   Int
  fiscalYear  Int
  status      String   @default("pending") // pending / posted
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([tenantId])
  @@map("accrued_revenues")
}

model AccruedExpense {
  id          Int      @id @default(autoincrement())
  tenantId    Int
  description String
  amount      Decimal  @db.Decimal(18, 2)
  accrualDate DateTime
  account     Account  @relation(fields: [accountId], references: [id])
  accountId   Int
  fiscalYear  Int
  status      String   @default("pending") // pending / posted
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([tenantId])
  @@map("accrued_expenses")
}

// ============================================================
// 法人・統合会計 — Phase 6: 法人ガバナンス機能
// ============================================================

// 役員
model Officer {
  id        Int      @id @default(autoincrement())
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  tenantId  Int
  name      String
  title     String
  termStart DateTime
  termEnd   DateTime
  salary    Decimal? @db.Decimal(18, 2)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("officers")
}

// 株主総会
model ShareholderMeeting {
  id          Int      @id @default(autoincrement())
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  tenantId    Int
  meetingDate DateTime
  meetingType String   @default("regular") // regular / extraordinary
  agenda      String
  resolution  String?
  minutesUrl  String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("shareholder_meetings")
}

// 配当
model Dividend {
  id             Int      @id @default(autoincrement())
  tenant         Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  tenantId       Int
  resolutionDate DateTime
  paymentDate    DateTime
  perShareAmount Decimal  @db.Decimal(18, 4)
  totalAmount    Decimal  @db.Decimal(18, 2)
  note           String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@map("dividends")
}

// 決算公告
model Announcement {
  id               Int      @id @default(autoincrement())
  tenant           Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  tenantId         Int
  announcementDate DateTime
  method           String   @default("WEBSITE") // KANPO / NEWSPAPER / WEBSITE
  content          String?
  fiscalYear       Int
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@map("announcements")
}

// ============================================================
// 家庭 ↔ 法人 勘定科目変換システム
// 参照: docs/account-conversion-system.md
// ============================================================

enum AccountMappingMatchType {
  TABLE // 変換テーブル直引き（定義済みH-prefix科目）
  KEYWORD // キーワードルール（「税」「保険」等）
  FUZZY // あいまい一致（類似度スコア）
  AI_FREE // AI推論（無料・軽量モデル）
  AI_PAID // AI推論（有料・高精度モデル）
  MANUAL // ユーザー手動マッピング
}

enum AccountConversionMode {
  HOME
  CORPORATE
}

enum AccountConversionStatus {
  COMPLETED
  CANCELLED
}

// 勘定科目変換ルールマスタ（システム定義 + ユーザー独自ルール）
model AccountMappingRule {
  id              Int                     @id @default(autoincrement())
  homeCode        String // 家庭モード科目コード（H-prefix）
  corporateCode   String? // 法人科目コード（変換不可の場合 null）
  matchType       AccountMappingMatchType @default(TABLE)
  confidenceScore Float                   @default(1.0) // 0.0〜1.0
  isConvertible   Boolean                 @default(true) // false = 変換不可（❌科目）
  notes           String? // 調整区分・税務注意事項等のメモ
  userId          Int? // null = システム定義、値あり = ユーザー独自ルール
  createdAt       DateTime                @default(now())
  updatedAt       DateTime                @updatedAt

  @@unique([homeCode, userId])
  @@index([homeCode])
  @@index([userId])
  @@map("account_mapping_rules")
}

// 変換セッション（モード切替ごとに1レコード）
model AccountConversionSession {
  id          Int                     @id @default(autoincrement())
  userId      Int
  fromMode    AccountConversionMode
  toMode      AccountConversionMode
  convertedAt DateTime                @default(now())
  status      AccountConversionStatus @default(COMPLETED)

  logs AccountConversionLog[]

  @@index([userId])
  @@map("account_conversion_sessions")
}

// 変換ログ（セッション内の科目ごとの変換結果）
model AccountConversionLog {
  id                   Int                      @id @default(autoincrement())
  session              AccountConversionSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  sessionId            Int
  homeAccountId        Int // 変換元科目（Account.id）
  corporateAccountId   Int? // 変換先科目（変換不可の場合 null）
  matchType            AccountMappingMatchType
  confidenceScore      Float? // 信頼度スコア（0.0〜1.0）
  isConvertible        Boolean                  @default(true)
  isManuallyOverridden Boolean                  @default(false)
  createdAt            DateTime                 @default(now())

  @@index([sessionId])
  @@map("account_conversion_logs")
}

// AI有料変換結果キャッシュ（30日間再利用）
model AiConversionResult {
  id                Int      @id @default(autoincrement())
  cacheKey          String   @unique // SHA256(accountName + ":" + businessType)
  inputContext      Json // AIに渡したコンテキスト全体
  primaryCode       String // 推奨変換先科目コード
  primaryReason     String // 選択理由
  taxClassification String // 課税 / 非課税 / 免税 / 不課税
  taxNotes          String? // 税務上の注意事項
  alternatives      Json // 代替候補リスト
  confidenceScore   Float // 信頼度スコア（0.0〜1.0）
  confidenceReason  String // 信頼度の根拠説明
  warnings          Json // 注意事項リスト
  modelId           String // 使用したLLMモデルID
  cachedUntil       DateTime // キャッシュ有効期限（30日）
  createdAt         DateTime @default(now())

  @@map("ai_conversion_results")
}

// AI有料変換利用履歴・課金ログ
model AiConversionUsage {
  id              Int      @id @default(autoincrement())
  userId          Int
  sessionId       Int
  accountCount    Int // 変換対象科目数
  cachedCount     Int // キャッシュヒット数（課金対象外）
  billedCount     Int // 実際にAPI呼び出しした科目数
  plan            String // PAY_PER_USE / MONTHLY
  chargedAt       DateTime @default(now())
  reportGenerated Boolean  @default(false)

  @@index([userId])
  @@index([sessionId])
  @@map("ai_conversion_usages")
}

